#theorem(name:[Теорема Мюрера], body:[
  $f$ - локально имеет первообразную в $G$  $=>$ $f$ - голоморфна.
], proof:[
  $a in G, B(a,r) subset G$, $F$ - первообразная функции $f => F$ голоморфная в $B(a,r) =>$ $F$ аналитическая в $B(a,r) => F' = f$ - аналитическая $=>$ голоморфная
])